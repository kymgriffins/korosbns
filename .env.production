# ── Production environment variables ──────────────────────────────────
# These are baked into the Next.js build at `next build` time.

# app
NEXT_PUBLIC_APP_NAME="Budget Ndio Story"
NEXT_PUBLIC_APP_URL="https://budgetndiostory.org"
NEXT_PUBLIC_SITE_URL="https://budgetndiostory.org"
NEXT_PUBLIC_API_BASE_URL="https://api.budgetndiostory.org"

# tasks api (django)
TASKS_API_URL="https://api.budgetndiostory.org/api/roadmap/"
TASKS_API_UPDATE_URL="https://api.budgetndiostory.org/api/roadmap/{id}/"

# django admin auth
DJANGO_AUTH_LOGIN_URL="https://api.budgetndiostory.org/api/auth/login/"
DJANGO_AUTH_REGISTER_URL="https://api.budgetndiostory.org/api/auth/register/"
DJANGO_AUTH_LOGOUT_URL="https://api.budgetndiostory.org/api/auth/logout/"
DJANGO_AUTH_REFRESH_URL="https://api.budgetndiostory.org/api/auth/refresh/"
DJANGO_AUTH_PROFILE_URL="https://api.budgetndiostory.org/api/auth/profile/"
DJANGO_ADMIN_MODELS_URL="https://api.budgetndiostory.org/api/admin/models/"
