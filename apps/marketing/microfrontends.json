{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "options": {
    "localProxyPort": 3024
  },
  "applications": {
    "budgetndiostory": {
      "packageName": "@korosbns/marketing",
      "development": {
        "local": 3000,
        "fallback": "https://budgetndiostory.org"
      }
    },
    "budgetndiostory-budgethub": {
      "packageName": "@korosbns/budgethub",
      "development": {
        "local": 3002,
        "fallback": "https://budgetndiostory.org"
      },
      "routing": [
        {
          "paths": ["/budgethub", "/budgethub/:path*"]
        }
      ]
    }
  }
}
