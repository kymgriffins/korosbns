# Copy to `.env.local` for local dev (localhost:3000)

# --- Two-terminal local stack (citizen + staff) ---
# Terminal 1: cd ../bnske.budgetndiostory.org && python manage.py runserver  (port 8000)
# Terminal 2: npm run dev  (port 3000)
# Uncomment local Django target:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production API only (no local Django):
# NEXT_PUBLIC_API_BASE_URL=https://bnske.budgetndiostory.org

# On localhost, the browser calls this URL directly (avoids Next trailing-slash proxy loops on POST).
# Without .env.local, rewrites target production and auth will fail locally.
# Backend CORS/CSRF defaults include http://localhost:3000 and http://localhost:3000.

# Optional override for rewrites only (defaults to NEXT_PUBLIC_API_BASE_URL):
# API_PROXY_TARGET=http://localhost:8000

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_ORG_SLUG=bns-default

# Optional: structured debug panel in browser
# NEXT_PUBLIC_DEBUG_LOGS=true

# Preview legacy Learn "Stories" swipe row (hidden in production until gem-clips ship)
# NEXT_PUBLIC_ENABLE_LEARN_STORIES=true

# Learn hub: `/learn` uses API stories when available. In development only, if the API
# returns zero published stories, `src/constants/stories.json` is used (not on network failure).

# --- Vercel Web Analytics / Speed Insights (citizen app) ---
# Enable both features in Vercel → Project → Analytics.
# Collection scripts are mounted via <SiteAnalytics /> in the root layout.
# NEXT_PUBLIC_VERCEL_ANALYTICS=true
# NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=true

# Admin traffic charts are synced by Django from the Vercel Query API.
# Set these on bnske (not required in this frontend .env unless you run an API proxy):
#   VERCEL_API_TOKEN=
#   VERCEL_PROJECT_ID=
#   VERCEL_TEAM_ID=

# --- First-party BNS site tracker (VPS-ready, no SaaS) ---
# Posts every route to Django /api/v1/track/event/ ? AnalyticsEvent warehouse.
NEXT_PUBLIC_BNS_ANALYTICS=true
# Vercel scripts default on only when VERCEL=1; force off on a VPS:
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=false
