# ── Local development overrides ──────────────────────────────────────
# Copy this file to .env.local to work against your local Django API.
# .env.local is gitignored and takes precedence over .env.production.

NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
TASKS_API_URL="http://127.0.0.1:8000/api/roadmap/"
TASKS_API_UPDATE_URL="http://127.0.0.1:8000/api/roadmap/{id}/"

DJANGO_AUTH_LOGIN_URL="http://127.0.0.1:8000/api/auth/login/"
DJANGO_AUTH_REGISTER_URL="http://127.0.0.1:8000/api/auth/register/"
DJANGO_AUTH_LOGOUT_URL="http://127.0.0.1:8000/api/auth/logout/"
DJANGO_AUTH_REFRESH_URL="http://127.0.0.1:8000/api/auth/refresh/"
DJANGO_AUTH_PROFILE_URL="http://127.0.0.1:8000/api/auth/profile/"
DJANGO_ADMIN_MODELS_URL="http://127.0.0.1:8000/api/admin/models/"
