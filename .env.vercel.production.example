# =============================================================================
# Budget Ndio Story — Vercel Production Environment Variables
# Copy each KEY=VALUE into: Vercel → Project → Settings → Environment Variables
# Scope: Production (add Preview with same values if you test on *.vercel.app)
# =============================================================================
#
# CRITICAL:
#   NEXT_PUBLIC_API_BASE_URL = Django API host (bnske), NOT the marketing site URL.
#   NEXT_PUBLIC_SITE_URL     = Citizen Next.js site (budgetndiostory.org).
#   Do NOT swap these — registration will return 500 if the API URL points at the frontend.
#
# After saving env vars: Redeploy (required for NEXT_PUBLIC_* to apply).

# --- Required (citizen app) ---
NEXT_PUBLIC_API_BASE_URL=https://bnske.budgetndiostory.org
API_PROXY_TARGET=https://bnske.budgetndiostory.org
NEXT_PUBLIC_SITE_URL=https://budgetndiostory.org
NEXT_PUBLIC_DEFAULT_ORG_SLUG=bns-default

# --- Recommended toggles ---
NEXT_PUBLIC_ALLOW_ADMIN_SIGNUP=false
NEXT_PUBLIC_ENABLE_WIP=false
NEXT_PUBLIC_DEBUG_LOGS=false

# --- Vercel Web Analytics / Speed Insights ---
# Enable in Vercel dashboard (Analytics + Speed Insights). Scripts auto-inject on deploy.
NEXT_PUBLIC_VERCEL_ANALYTICS=true
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=true

# --- Optional: error monitoring (leave empty to disable) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Optional: Cloudinary cohort images API route only ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Optional: document repository upstream override ---
# DOC_REPOSITORY_UPSTREAM_URL=https://api.budgetndiostory.org

# --- Vercel sets automatically (do not add manually) ---
# VERCEL=1
# VERCEL_URL=your-deployment.vercel.app
# NODE_ENV=production
