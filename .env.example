# =============================================================================
# Budget Ndio Story — environment reference
# Local dev: copy .env.local.example → .env.local
# Vercel:    copy .env.vercel.production.example → Vercel Environment Variables
# =============================================================================

# API host (Django on bnske) — NEVER set this to budgetndiostory.org
NEXT_PUBLIC_API_BASE_URL=https://bnske.budgetndiostory.org

# Next.js rewrites + server proxy target (usually same as API base)
API_PROXY_TARGET=https://bnske.budgetndiostory.org

# Public citizen site URL (canonical links, metadata, email deep links)
NEXT_PUBLIC_SITE_URL=https://budgetndiostory.org

NEXT_PUBLIC_DEFAULT_ORG_SLUG=bns-default
NEXT_PUBLIC_ALLOW_ADMIN_SIGNUP=false
NEXT_PUBLIC_ENABLE_WIP=false
NEXT_PUBLIC_DEBUG_LOGS=false

# Email (SMTP for frontend email hook polling)
# Production values in .env.vercel — copy SMTP_HOST/SMTP_PORT/SMTP_SECURE/SMTP_USER/SMTP_PASS/SMTP_FROM from backend .env.prod
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@budgetndiostory.org
# SMTP_PASS=your-app-password
# SMTP_FROM="Budget Ndio Story <noreply@budgetndiostory.org>"
# EMAIL_HOOK_API_KEY=your-api-key

