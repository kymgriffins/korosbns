# Citizen frontend — copy to `.env.local` for local dev (see `.env.local.example`)

# API proxy target (Next rewrites + server-side fetch). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://bnske.budgetndiostory.org
# Local Django: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical public site URL (share links, metadata)
NEXT_PUBLIC_SITE_URL=https://budgetndiostory.org

NEXT_PUBLIC_DEFAULT_ORG_SLUG=bns-default

# Browser: relative `/api/v1/*` via Next rewrites (see next.config.ts).
# Survey POST uses credentials: include — API must list your frontend in CORS + CSRF.

# Static/citizen production deploy (see CITIZEN_MVP.md):
# NEXT_PUBLIC_API_BASE_URL=https://bnske.budgetndiostory.org
# NEXT_PUBLIC_SITE_URL=https://budgetndiostory.org
