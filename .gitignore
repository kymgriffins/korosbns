# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — ignore all; only commit *.example templates
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# scratch
scratch/

# typescript
*.tsbuildinfo
next-env.d.ts

# others
.cursor/

# turbo
.turbo/

# lighthouse profiles & reports
.lh-profile/
.lh-chrome-profile/
.impeccable/
reports/lighthouse/*.json
!reports/lighthouse/summary.json

# npm/yarn lockfiles (pnpm workspace)
package-lock.json
yarn.lock
bun.lockb

# Large media assets (hosted on Cloudflare R2 bucket `bns`)
*.mp4
*.mov
*.webm
public/images/reels/*.mp4
public/videos/